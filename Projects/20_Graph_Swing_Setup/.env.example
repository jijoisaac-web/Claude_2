# Copy to .env for local runs. In GitHub Actions, these are set as repo
# Secrets instead (Settings -> Secrets and variables -> Actions) and never
# committed here.

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Only needed if the daily_pipeline.yml workflow deploys to Cloudflare Pages.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
